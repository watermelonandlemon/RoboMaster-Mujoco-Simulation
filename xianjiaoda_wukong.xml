<?xml version="1.0" encoding="utf-8"?>
<mujoco model="RoboMaster_uncontrolled_dart">
    <compiler angle="degree" meshdir="meshes" autolimits="true"/>
    <option timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"
        density="1.225"
        viscosity="1.8e-5"/>

    <asset>
        <!-- STL coordinates are in millimetres; scale converts them to metres. -->
        <mesh name="dart_visual" file="dart_visual.stl"
              scale="0.001 0.001 0.001"/>
    </asset>

    <worldbody>
        <light name="top" pos="0 0 1.5" dir="0 0 -1"/>
        <geom name="ground" type="plane" pos="0 0 0"
              size="2 2 0.1" rgba="0.82 0.84 0.86 1"/>

        <!-- One free body: the entire dart is a single rigid body.
             The nose is along +Z; the tail is along -Z. -->
        <body name="dart" pos="0 0 1.50"  euler="0 180 0">
            <freejoint name="dart_free"/>

            <!-- Visual geometry: all assembly components are combined into
                 one mesh, so their relative positions remain fixed. -->
            <geom name="dart_visual_geom" type="mesh" mesh="dart_visual"
                  contype="0" conaffinity="0" group="2"
                  rgba="0.72 0.75 0.80 1"/>

            <!-- Simplified collision geometry. It is intentionally separate
                 from the detailed visual mesh for more stable simulation. -->
            <geom name="dart_body_collision" type="capsule"
                  fromto="0 0 -0.085 0 0 0.085"
                  size="0.012" rgba="0.2 0.4 0.8 0.15"
                  contype="1" conaffinity="1" group="3"/>
            <geom name="dart_tail_collision" type="box"
                  pos="0 0 -0.080" size="0.050 0.050 0.008"
                  rgba="0.2 0.4 0.8 0.15"
                  contype="1" conaffinity="1" group="3"/>

            <!-- Initial placeholder values. Replace with measured mass and
                 inertia for quantitative dynamics work. -->
            <inertial pos="0 0 0" mass="0.3915"
                      diaginertia="0.0010 0.0010 0.00003"/>
        </body>
    </worldbody>
</mujoco>
